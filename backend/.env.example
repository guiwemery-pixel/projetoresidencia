# Copie para .env e ajuste.
DATABASE_URL="postgresql://estudos:estudos@localhost:5432/estudos?schema=public"
# Banco usado pelos testes de integração (será limpo a cada execução!)
TEST_DATABASE_URL="postgresql://estudos:estudos@localhost:5432/estudos_test?schema=public"
PORT=3333
NODE_ENV=development
# Origem do frontend em desenvolvimento (Vite)
CORS_ORIGIN="http://localhost:5173"
# Duração da sessão em dias
SESSION_TTL_DAYS=30
# Espaço máximo dos flashcards de cada usuário na conta (MB)
# FLASHCARDS_QUOTA_MB=100
# Imagens dos flashcards no Cloudflare R2 (opcional; sem isto ficam no banco). Ver docs/DEPLOY-VERCEL.md
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="flashcards"
# Espaço máximo das imagens de cada usuário no R2 (MB)
# FLASHCARDS_MEDIA_QUOTA_MB=1024
# Intervalo (minutos) do job que gera notificações
NOTIFICATIONS_JOB_MINUTES=60
# Cookie "Secure" (exige HTTPS). Padrão: true em produção, false em desenvolvimento.
# COOKIE_SECURE=false
